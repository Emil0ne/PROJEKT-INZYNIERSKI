# Skopiuj ten plik do .env i uzupełnij wartości:  cp .env.example .env
# Plik .env NIE trafia do repozytorium (jest w .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=travel_assistant
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=zmien_mnie
POSTGRES_PORT=5432

# --- Backend (.NET) w Dockerze ---
# Klucz OpenAI - podwójne podkreślenie mapuje się na OpenAI:ApiKey w appsettings.
# Puste = działa tylko /api/Trips/mock, /generate zwróci 502.
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini
API_PORT=5022
# Connection string dla API uruchamianego lokalnie (poza Dockerem):
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=travel_assistant;Username=dev_user;Password=zmien_mnie
